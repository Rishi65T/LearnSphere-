# LearnSphere AI — Gemini API key (required for live SphereBot, quizzes, and path planner)
# Get a free key at: https://aistudio.google.com/apikey
# Paste it below, then restart the dev server (npm run dev)
GEMINI_API_KEY="AIzaSy..."

# Google Sign-In — OAuth Client ID (Web application)
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID → Web application
# 3. Add Authorized JavaScript origin: http://localhost:3000
# 4. Paste the Client ID below, then restart the dev server
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Optional: public app URL for OAuth callbacks and self-referential links
APP_URL="http://localhost:3000"
